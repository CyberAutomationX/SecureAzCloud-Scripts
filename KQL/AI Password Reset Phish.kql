// Name: AI Password Reset Phish
// Purpose: Find password-reset or account-security emails themed around AI services.
// Data Source(s): EmailEvents
// Tuning: Pair with identity sign-in investigations when users clicked or provided credentials.


let Lookback = 14d;
let ResetTerms = dynamic(["password reset", "reset your password", "security alert", "verify your account", "suspicious sign-in", "login attempt", "mfa reset"]);
let AIBrands = dynamic(["openai", "chatgpt", "gpt", "claude", "anthropic", "gemini", "copilot", "microsoft 365 copilot", "azure ai", "azure openai", "perplexity", "mistral", "hugging face"]);
EmailEvents
| where Timestamp > ago(Lookback)
| extend Subject_l = tolower(Subject),
         Display_l = tolower(SenderDisplayName),
         Domain_l = tolower(SenderFromDomain),
         Delivery_l = tolower(DeliveryAction)
| where Subject_l has_any (AIBrands) or Display_l has_any (AIBrands) or Domain_l has_any (AIBrands)
| where Subject_l has_any (ResetTerms)
| where not(Delivery_l has_any (dynamic(["blocked", "dropped", "rejected"])))
| summarize DeliveredCount = count(),
            Recipients = make_set(RecipientEmailAddress, 100),
            Subjects = make_set(Subject, 25),
            Threats = make_set(ThreatTypes, 10)
    by SenderFromAddress, SenderFromDomain, SenderDisplayName
| sort by DeliveredCount desc
