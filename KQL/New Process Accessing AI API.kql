// Name: New Process Accessing AI API
// Purpose: Detect first-time process hashes or newly observed binaries contacting public AI APIs from a device.
// Data Source(s): DeviceNetworkEvents
// Tuning: Review internally developed tooling and code-assistant wrappers that may legitimately contact AI services for the first time.


let RecentWindow = 1d;
let HistoricalWindow = 30d;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
let HistoricalProcesses =
DeviceNetworkEvents
| where Timestamp between (ago(HistoricalWindow) .. ago(RecentWindow))
| extend RemoteUrl_l = tolower(RemoteUrl), ProcHash = iff(isempty(InitiatingProcessSHA1), strcat("NOHASH:", tolower(InitiatingProcessFileName)), InitiatingProcessSHA1)
| where isnotempty(RemoteUrl_l) and RemoteUrl_l has_any (AIDomains)
| summarize by DeviceName, ProcHash;
DeviceNetworkEvents
| where Timestamp > ago(RecentWindow)
| extend RemoteUrl_l = tolower(RemoteUrl),
         Actor = iff(isempty(InitiatingProcessAccountUpn), strcat(InitiatingProcessAccountDomain, "\\", InitiatingProcessAccountName), InitiatingProcessAccountUpn),
         ProcHash = iff(isempty(InitiatingProcessSHA1), strcat("NOHASH:", tolower(InitiatingProcessFileName)), InitiatingProcessSHA1)
| where isnotempty(RemoteUrl_l) and RemoteUrl_l has_any (AIDomains)
| join kind=leftanti HistoricalProcesses on DeviceName, ProcHash
| summarize ConnectionCount = count(), RemoteUrls = make_set(RemoteUrl, 20)
    by DeviceName, DeviceId, Actor, InitiatingProcessFileName, InitiatingProcessSHA1, InitiatingProcessParentFileName
| where ConnectionCount >= 2
| sort by ConnectionCount desc
