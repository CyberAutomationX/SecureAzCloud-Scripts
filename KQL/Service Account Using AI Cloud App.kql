// Name: Service Account Using AI Cloud App
// Purpose: Detect likely service, shared, or automation accounts interacting with AI cloud apps.
// Data Source(s): CloudAppEvents
// Tuning: Refine the service-account matcher with your naming convention or a watchlist.


let Lookback = 7d;
let AIApps = dynamic(["chatgpt", "openai", "claude", "anthropic", "gemini", "copilot", "copilot studio", "azure ai", "azure openai", "perplexity", "mistral", "hugging face"]);
CloudAppEvents
| where Timestamp > ago(Lookback)
| extend App = tolower(Application),
         User = coalesce(AccountId, AccountDisplayName)
| where App has_any (AIApps)
| where User has_any (dynamic(["svc", "service", "automation", "runbook", "daemon", "bot", "app@"]))
| summarize EventCount = count(),
            Apps = make_set(Application, 20),
            Actions = make_set(ActionType, 25),
            Activities = make_set(ActivityType, 25),
            IPs = make_set(IPAddress, 20)
    by User, DeviceType, OSPlatform
| sort by EventCount desc
