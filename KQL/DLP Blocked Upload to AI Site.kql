// Name: DLP Blocked Upload to AI Site
// Purpose: Find DLP-enforced blocks involving uploads or transfers to AI domains.
// Data Source(s): DataSecurityEvents
// Tuning: Ideal for validating whether AI egress controls are actually triggering.


let Lookback = 14d;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
DataSecurityEvents
| where Timestamp > ago(Lookback)
| extend TargetDomain_l = tolower(TargetUrlDomain),
         Unallowed_l = tolower(tostring(UnallowedUrlDomains)),
         Enforcement_l = tolower(DlpPolicyEnforcementMode)
| where TargetDomain_l has_any (AIDomains) or Unallowed_l has_any (AIDomains)
| where Enforcement_l has_any (dynamic(["block", "blocked", "auditandblock"]))
| project Timestamp, AccountUpn, Workload, ObjectName, ObjectType, ObjectSize, TargetUrlDomain, UnallowedUrlDomains, SensitiveInfoTypeInfo, SensitivityLabelId, DlpPolicyEnforcementMode, DeviceSourceLocationType, DeviceDestinationLocationType
| sort by Timestamp desc
