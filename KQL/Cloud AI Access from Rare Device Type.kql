// Name: Cloud AI Access from Rare Device Type
// Purpose: Detect AI cloud app access from device types not seen for the same user in the prior two weeks.
// Data Source(s): CloudAppEvents
// Tuning: Good for spotting mobile-only access, unmanaged clients, or atypical endpoints.


let RecentWindow = 1d;
let BaselineWindow = 14d;
let AIApps = dynamic(["chatgpt", "openai", "claude", "anthropic", "gemini", "copilot", "copilot studio", "azure ai", "azure openai", "perplexity", "mistral", "hugging face"]);
let Recent =
    CloudAppEvents
    | where Timestamp > ago(RecentWindow)
    | extend App = tolower(Application),
             User = coalesce(AccountId, AccountDisplayName),
             DeviceType_l = tolower(DeviceType)
    | where App has_any (AIApps)
    | where isnotempty(User) and isnotempty(DeviceType_l)
    | summarize RecentCount = count(),
                RecentIPs = make_set(IPAddress, 20),
                Apps = make_set(Application, 20)
        by User, DeviceType_l;
let Baseline =
    CloudAppEvents
    | where Timestamp between (ago(BaselineWindow) .. ago(RecentWindow))
    | extend App = tolower(Application),
             User = coalesce(AccountId, AccountDisplayName),
             DeviceType_l = tolower(DeviceType)
    | where App has_any (AIApps)
    | where isnotempty(User) and isnotempty(DeviceType_l)
    | summarize BaselineCount = count() by User, DeviceType_l;
Recent
| join kind=leftouter Baseline on User, DeviceType_l
| where coalesce(BaselineCount, 0) == 0
| sort by RecentCount desc
