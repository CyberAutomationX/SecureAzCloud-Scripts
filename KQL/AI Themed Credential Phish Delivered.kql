// Name: AI Themed Credential Phish Delivered
// Purpose: Detect delivered phishing emails themed around AI brands, accounts, invitations, or prompts.
// Data Source(s): EmailEvents
// Tuning: Tune delivery filters to your transport pipeline and quarantine naming.


let Lookback = 14d;
let AIBrands = dynamic(["openai", "chatgpt", "gpt", "claude", "anthropic", "gemini", "copilot", "microsoft 365 copilot", "azure ai", "azure openai", "perplexity", "mistral", "hugging face"]);
let CredentialTerms = dynamic(["password", "sign in", "signin", "log in", "login", "verify", "suspended", "security alert", "reset", "credential", "mfa"]);
EmailEvents
| where Timestamp > ago(Lookback)
| extend Subject_l = tolower(Subject),
         Display_l = tolower(SenderDisplayName),
         Domain_l = tolower(SenderFromDomain),
         Threats_l = tolower(ThreatTypes),
         Detections_l = tolower(DetectionMethods),
         Delivery_l = tolower(DeliveryAction),
         Location_l = tolower(DeliveryLocation)
| where Subject_l has_any (AIBrands) or Display_l has_any (AIBrands) or Domain_l has_any (AIBrands)
| where Subject_l has_any (CredentialTerms)
| where Threats_l has_any (dynamic(["phish", "malware", "suspicious"])) or Detections_l has_any (dynamic(["phish", "spoof", "impersonation", "malicious"]))
| where not(Delivery_l has_any (dynamic(["blocked", "dropped", "rejected"])))
| summarize DeliveredCount = count(),
            Recipients = make_set(RecipientEmailAddress, 50),
            Subjects = make_set(Subject, 20),
            Threats = make_set(ThreatTypes, 10)
    by SenderFromAddress, SenderFromDomain, SenderDisplayName
| sort by DeliveredCount desc
