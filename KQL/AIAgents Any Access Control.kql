// Name: AIAgents Any Access Control
// Purpose: Find AI agents with broad or weak access-control settings.
// Data Source(s): AIAgentsInfo
// Tuning: Best for Copilot Studio or agent governance reviews. Validate intended sharing models before alerting.


let Lookback = 30d;
AIAgentsInfo
| where Timestamp > ago(Lookback)
| extend AccessPolicy_l = tolower(AccessControlPolicy),
         GroupCount = array_length(todynamic(AuthorizedSecurityGroupIds))
| where AccessPolicy_l has_any (dynamic(["any", "everyone", "all users", "public"])) or GroupCount == 0
| project Timestamp, AIAgentName, AIAgentId, Platform, EnvironmentId, CreatorAccountUpn, OwnerAccountUpns, AccessControlPolicy, AuthorizedSecurityGroupIds, UserAuthenticationType, AuthenticationTrigger, AgentStatus, LastModifiedByUpn
| sort by Timestamp desc
