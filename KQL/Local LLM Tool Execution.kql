// Name: Local LLM Tool Execution
// Purpose: Detect execution of local LLM tooling such as Ollama, LM Studio, llamafile, and related offline model runners.
// Data Source(s): DeviceProcessEvents
// Tuning: Some AI engineering teams use local model runners legitimately; use tags or device groups to scope expected hosts.


let Lookback = 7d;
let LocalLLMTools = dynamic(["ollama", "lmstudio", "koboldcpp", "text-generation-webui", "vllm", "oobabooga", "llamafile"]);
DeviceProcessEvents
| where Timestamp > ago(Lookback)
| extend Proc = tolower(FileName), Cmd = tolower(ProcessCommandLine),
         Actor = iff(isempty(AccountUpn), strcat(AccountDomain, "\\", AccountName), AccountUpn)
| where Proc has_any (LocalLLMTools) or Cmd has_any (LocalLLMTools)
| summarize ExecutionCount = count(), SampleCommands = make_set(ProcessCommandLine, 10), FirstSeen = min(Timestamp), LastSeen = max(Timestamp)
    by DeviceName, DeviceId, Actor, FileName, SHA1, InitiatingProcessFileName
| sort by ExecutionCount desc
