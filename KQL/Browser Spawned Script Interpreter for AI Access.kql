// Name: Browser Spawned Script Interpreter for AI Access
// Purpose: Detect browsers spawning script interpreters that quickly connect to AI services, a pattern common in weaponized browser workflows.
// Data Source(s): DeviceProcessEvents, DeviceNetworkEvents
// Tuning: Exclude approved developer browser extensions or sanctioned local helper apps if they intentionally launch interpreters.


let Lookback = 7d;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
let Browsers = dynamic(["chrome.exe","msedge.exe","firefox.exe","iexplore.exe","opera.exe","brave.exe","safari.exe"]);
let Interpreters = dynamic(["powershell.exe","pwsh.exe","python.exe","pythonw.exe","node.exe","wscript.exe","cscript.exe","cmd.exe","bash","sh","zsh"]);
let BrowserSpawnedInterpreters =
DeviceProcessEvents
| where Timestamp > ago(Lookback)
| extend ParentProc = tolower(InitiatingProcessFileName), ChildProc = tolower(FileName),
         Actor = iff(isempty(AccountUpn), strcat(AccountDomain, "\\", AccountName), AccountUpn)
| where set_has_element(Browsers, ParentProc) and set_has_element(Interpreters, ChildProc)
| project SpawnTime = Timestamp, DeviceId, DeviceName, Actor, ChildProc, ParentProc, ProcessCommandLine;
let AITraffic =
DeviceNetworkEvents
| where Timestamp > ago(Lookback)
| extend RemoteUrl_l = tolower(RemoteUrl), Proc = tolower(InitiatingProcessFileName),
         Actor = iff(isempty(InitiatingProcessAccountUpn), strcat(InitiatingProcessAccountDomain, "\\", InitiatingProcessAccountName), InitiatingProcessAccountUpn)
| where isnotempty(RemoteUrl_l) and RemoteUrl_l has_any (AIDomains)
| where set_has_element(Interpreters, Proc)
| project NetworkTime = Timestamp, DeviceId, DeviceName, Actor, Proc, RemoteUrl, InitiatingProcessCommandLine;
BrowserSpawnedInterpreters
| join kind=innerunique AITraffic on DeviceId, DeviceName, Actor
| where Proc == ChildProc
| where NetworkTime between (SpawnTime .. SpawnTime + 15m)
| summarize AIConnections = count(), RemoteUrls = make_set(RemoteUrl, 20), SampleCommands = make_set(ProcessCommandLine, 5)
    by DeviceName, Actor, ParentProc, ChildProc, SpawnTime
| sort by SpawnTime desc
