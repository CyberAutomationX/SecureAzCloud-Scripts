// Name: AI Agentic Sign-in from New IP
// Purpose: Detect agentic sign-in activity to AI-related apps from source IPs not seen for the same user in the prior two weeks.
// Data Source(s): SigninLogs
// Tuning: Requires the Agent field in SigninLogs. Very useful for agentic or delegated access models.


let RecentWindow = 1d;
let BaselineWindow = 14d;
let AIApps = dynamic(["openai", "chatgpt", "claude", "anthropic", "gemini", "copilot", "copilot studio", "azure ai", "azure openai", "cognitive services", "ai foundry", "perplexity", "mistral"]);
let Recent =
    SigninLogs
    | where TimeGenerated > ago(RecentWindow)
    | extend AppComposite = tolower(strcat(coalesce(AppDisplayName, ""), " ", coalesce(ResourceDisplayName, ""))),
             User = tostring(UserPrincipalName),
             AgentType = tolower(tostring(Agent.agentType))
    | where AppComposite has_any (AIApps)
    | where ResultType == 0 and isnotempty(User) and isnotempty(IPAddress) and isnotempty(AgentType)
    | summarize RecentCount = count(), AgentTypes = make_set(AgentType, 10), Apps = make_set(AppDisplayName, 10), UserAgents = make_set(UserAgent, 10) by User, IPAddress;
let Baseline =
    SigninLogs
    | where TimeGenerated between (ago(BaselineWindow) .. ago(RecentWindow))
    | extend AppComposite = tolower(strcat(coalesce(AppDisplayName, ""), " ", coalesce(ResourceDisplayName, ""))),
             User = tostring(UserPrincipalName),
             AgentType = tolower(tostring(Agent.agentType))
    | where AppComposite has_any (AIApps)
    | where ResultType == 0 and isnotempty(User) and isnotempty(IPAddress) and isnotempty(AgentType)
    | summarize BaselineCount = count() by User, IPAddress;
Recent
| join kind=leftouter Baseline on User, IPAddress
| where coalesce(BaselineCount, 0) == 0
| sort by RecentCount desc
