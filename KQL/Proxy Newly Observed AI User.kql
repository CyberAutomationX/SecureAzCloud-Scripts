// Name: Proxy Newly Observed AI User
// Purpose: Identify users whose first recorded AI-domain access occurred in the last day.
// Data Source(s): CommonSecurityLog
// Tuning: Useful for policy rollout and new-user monitoring. Exclude expected pilot populations.


let RecentWindow = 1d;
let SearchWindow = 30d;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
CommonSecurityLog
| where TimeGenerated > ago(SearchWindow)
| extend Host = coalesce(tolower(tostring(parse_url(RequestURL).Host)), tolower(DestinationHostName), tolower(RequestURL)),
         User = coalesce(SourceUserName, SourceUserID)
| where isnotempty(User) and isnotempty(Host) and Host has_any (AIDomains)
| summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), RequestCount = count(), Domains = make_set(Host, 20), SourceIPs = make_set(SourceIP, 20) by User
| where FirstSeen > ago(RecentWindow)
| sort by FirstSeen desc
