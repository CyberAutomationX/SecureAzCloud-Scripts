// Name: Source Code Access Before AI Upload
// Purpose: Detect source-code file access immediately followed by AI-domain network traffic from the same device and user.
// Data Source(s): DeviceFileEvents + DeviceNetworkEvents
// Tuning: Tune file extension coverage and the correlation window to your development workflow.


let Lookback = 7d;
let CorrelationWindow = 15m;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
let CodeExtensions = dynamic([".py", ".ipynb", ".js", ".ts", ".java", ".cs", ".go", ".rb", ".php", ".sh", ".ps1", ".psm1", ".sql", ".tf", ".tfvars", ".yml", ".yaml", ".json", ".xml", ".cpp", ".c", ".h", ".rs"]);
let CodeAccess =
    DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | extend FileExt = tostring(tolower(strcat(".", extract(@"([^.]+)$", 1, FileName)))),
             Actor = iff(isempty(InitiatingProcessAccountUpn), strcat(InitiatingProcessAccountDomain, "\\", InitiatingProcessAccountName), InitiatingProcessAccountUpn)
    | where set_has_element(CodeExtensions, FileExt)
    | where ActionType has_any (dynamic(["FileRead", "FileOpened", "FileModified", "FileCopied"]))
    | summarize CodeFileCount = dcount(FileName),
                Files = make_set(FileName, 100),
                Folders = make_set(FolderPath, 25),
                AccessingProcesses = make_set(InitiatingProcessFileName, 20)
        by DeviceId, DeviceName, Actor, bin(Timestamp, 15m)
    | where CodeFileCount >= 5;
let AIConnections =
    DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | extend RemoteUrl_l = tolower(RemoteUrl),
             Actor = iff(isempty(InitiatingProcessAccountUpn), strcat(InitiatingProcessAccountDomain, "\\", InitiatingProcessAccountName), InitiatingProcessAccountUpn)
    | where isnotempty(RemoteUrl_l) and RemoteUrl_l has_any (AIDomains)
    | summarize AIConnectionCount = count(),
                Domains = make_set(RemoteUrl, 25),
                NetworkProcesses = make_set(InitiatingProcessFileName, 20),
                CommandLines = make_set(InitiatingProcessCommandLine, 10)
        by DeviceId, DeviceName, Actor, bin(Timestamp, 15m);
CodeAccess
| join kind=innerunique AIConnections on DeviceId, DeviceName, Actor
| where Timestamp1 between (Timestamp .. Timestamp + CorrelationWindow)
| project CodeAccessTime = Timestamp, AIConnectionTime = Timestamp1, DeviceName, Actor, CodeFileCount, Files, Folders, AccessingProcesses, AIConnectionCount, Domains, NetworkProcesses, CommandLines
| sort by CodeAccessTime desc
