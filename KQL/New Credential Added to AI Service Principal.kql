// Name: New Credential Added to AI Service Principal
// Purpose: Detect service principal or application credential additions tied to AI-related apps or resources.
// Data Source(s): AuditLogs
// Tuning: Prioritize secret additions outside approved CI/CD identities or change windows.


let Lookback = 30d;
let AIResourceTerms = dynamic(["openai", "cognitive services", "azure ai", "copilot", "copilot studio", "ai foundry", "foundry"]);
AuditLogs
| where TimeGenerated > ago(Lookback)
| where ActivityDisplayName has_any (dynamic(["add service principal credentials", "add application password", "add password credential", "update application", "update service principal"]))
| mv-expand TargetResources
| extend TargetDisplayName = tolower(tostring(TargetResources.displayName)),
         ActorUser = tostring(InitiatedBy.user.userPrincipalName),
         ActorApp = tostring(InitiatedBy.app.displayName),
         ActorIP = tostring(InitiatedBy.user.ipAddress),
         Modified = tostring(TargetResources.modifiedProperties)
| where TargetDisplayName has_any (AIResourceTerms) or Modified has_any (AIResourceTerms)
| project TimeGenerated, ActivityDisplayName, TargetDisplayName, Actor = coalesce(ActorUser, ActorApp), ActorIP, Result, ResultReason, TargetResources, AdditionalDetails
| sort by TimeGenerated desc
