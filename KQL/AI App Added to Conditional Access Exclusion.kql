// Name: AI App Added to Conditional Access Exclusion
// Purpose: Detect conditional access policy changes that reference AI-related apps or resources in exclusions or targeting changes.
// Data Source(s): AuditLogs
// Tuning: Review carefully: excluding AI apps from CA or session controls can materially weaken tenant protections.


let Lookback = 30d;
let AIApps = dynamic(["openai", "chatgpt", "claude", "anthropic", "gemini", "copilot", "copilot studio", "azure ai", "azure openai", "cognitive services", "ai foundry", "perplexity", "mistral"]);
AuditLogs
| where TimeGenerated > ago(Lookback)
| where ActivityDisplayName has_any (dynamic(["update conditional access policy", "add conditional access policy"]))
| mv-expand TargetResources
| extend PolicyName = tostring(TargetResources.displayName),
         ActorUser = tostring(InitiatedBy.user.userPrincipalName),
         ActorApp = tostring(InitiatedBy.app.displayName),
         ActorIP = tostring(InitiatedBy.user.ipAddress),
         Modified = tolower(tostring(TargetResources.modifiedProperties)),
         Details = tolower(tostring(AdditionalDetails))
| where Modified has_any (AIApps) or Details has_any (AIApps)
| project TimeGenerated, PolicyName, ActivityDisplayName, Actor = coalesce(ActorUser, ActorApp), ActorIP, Result, ResultReason, AdditionalDetails, TargetResources
| sort by TimeGenerated desc
