// Name: Service Principal Secret Authentication to AI Resource
// Purpose: Find service principal sign-ins to AI resources that use client secrets rather than certificates or managed identity.
// Data Source(s): AADServicePrincipalSignInLogs
// Tuning: Client-secret authentication is often weaker than certificates or managed identity and warrants review.


let Lookback = 14d;
let AIResourceTerms = dynamic(["openai", "cognitive services", "azure ai", "copilot", "copilot studio", "ai foundry", "foundry"]);
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(Lookback)
| extend ResourceComposite = tolower(strcat(coalesce(AppDisplayName, ""), " ", coalesce(ResourceDisplayName, ""))),
         SPName = coalesce(ServicePrincipalName, AppDisplayName),
         CredType = tolower(tostring(ClientCredentialType))
| where ResourceComposite has_any (AIResourceTerms)
| where CredType has_any (dynamic(["secret", "clientsecret", "password"]))
| project TimeGenerated, SPName, ServicePrincipalId, AppId, ResourceDisplayName, IPAddress, UserAgent, ClientCredentialType, ResultType, ResultDescription
| sort by TimeGenerated desc
