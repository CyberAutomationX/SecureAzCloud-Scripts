// Name: AI Environment Variable Discovery
// Purpose: Detect commands that enumerate or print AI-related environment variables, which can reveal usable API keys.
// Data Source(s): DeviceProcessEvents
// Tuning: Review dev containers and CI agents separately if they intentionally enumerate environment variables during startup.


let Lookback = 7d;
DeviceProcessEvents
| where Timestamp > ago(Lookback)
| extend Cmd_l = tolower(ProcessCommandLine),
         Proc = tolower(FileName),
         Actor = iff(isempty(AccountUpn), strcat(AccountDomain, "\\", AccountName), AccountUpn)
| where Proc in ("powershell.exe","pwsh.exe","cmd.exe","bash","sh","zsh","python.exe","python3","wscript.exe","cscript.exe")
| where (Cmd_l has_any ("openai_api_key","azure_openai_api_key","anthropic_api_key","gemini_api_key","google_api_key","cohere_api_key","mistral_api_key","xai_api_key"))
       and (Cmd_l has_any ("echo","printenv","get-childitem env:","gci env:","get-item env:","set ","env ","export ","dir env:","os.environ","[environment]::getenvironmentvariable"))
| summarize ExecutionCount = count(), SampleCommands = make_set(ProcessCommandLine, 10)
    by DeviceName, DeviceId, Actor, FileName, InitiatingProcessFileName
| sort by ExecutionCount desc
