// Name: AI Access After Remote Interactive Logon
// Purpose: Identify AI access shortly after a remote interactive logon, a useful pattern for hands-on-keyboard exfiltration or staging.
// Data Source(s): DeviceLogonEvents, DeviceNetworkEvents
// Tuning: Tune the 30-minute correlation window for jump boxes, admin workstations, and helpdesk activity.


let Lookback = 7d;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
let RemoteLogons =
DeviceLogonEvents
| where Timestamp > ago(Lookback)
| where ActionType has "Logon" and LogonType has "Remote"
| extend Actor = iff(isempty(AccountUpn), strcat(AccountDomain, "\\", AccountName), AccountUpn)
| project LogonTime = Timestamp, DeviceId, DeviceName, Actor, RemoteIP, LogonType;
let AITraffic =
DeviceNetworkEvents
| where Timestamp > ago(Lookback)
| extend RemoteUrl_l = tolower(RemoteUrl),
         Actor = iff(isempty(InitiatingProcessAccountUpn), strcat(InitiatingProcessAccountDomain, "\\", InitiatingProcessAccountName), InitiatingProcessAccountUpn)
| where isnotempty(RemoteUrl_l) and RemoteUrl_l has_any (AIDomains)
| project NetworkTime = Timestamp, DeviceId, DeviceName, Actor, RemoteUrl, InitiatingProcessFileName, InitiatingProcessCommandLine;
RemoteLogons
| join kind=innerunique AITraffic on DeviceId, Actor
| where NetworkTime between (LogonTime .. LogonTime + 30m)
| summarize AIConnections = count(), RemoteUrls = make_set(RemoteUrl, 20), FirstAIUse = min(NetworkTime), LastAIUse = max(NetworkTime)
    by DeviceName, Actor, LogonTime, RemoteIP, LogonType
| sort by FirstAIUse desc
