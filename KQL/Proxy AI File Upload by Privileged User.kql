// Name: Proxy AI File Upload by Privileged User
// Purpose: Flag likely AI uploads performed by users marked as privileged in network security logs.
// Data Source(s): CommonSecurityLog
// Tuning: Refine privileged-user logic using your naming standards or join with an identity watchlist.


let Lookback = 7d;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
CommonSecurityLog
| where TimeGenerated > ago(Lookback)
| extend Host = coalesce(tolower(tostring(parse_url(RequestURL).Host)), tolower(DestinationHostName), tolower(RequestURL)),
         User = coalesce(SourceUserName, SourceUserID),
         Method = toupper(RequestMethod),
         Privs = tolower(SourceUserPrivileges)
| where isnotempty(Host) and Host has_any (AIDomains)
| where Method == "POST" or tolong(SentBytes) > 1048576
| where Privs has_any (dynamic(["admin", "administrator", "privileged", "root", "superuser"])) or User has_any (dynamic(["admin", "svc", "secops", "itops"]))
| summarize UploadCount = count(),
            TotalSentBytes = sum(tolong(SentBytes)),
            Domains = make_set(Host, 20),
            SampleUrls = make_set(RequestURL, 15)
    by User, SourceIP, SourceHostName, DeviceVendor, DeviceProduct
| sort by TotalSentBytes desc, UploadCount desc
