// Name: Cloud AI File Download Activity
// Purpose: Detect file download activity from AI cloud applications.
// Data Source(s): CloudAppEvents
// Tuning: Tune action keywords to your connected-app normalization and target AI services.


let Lookback = 7d;
let AIApps = dynamic(["chatgpt", "openai", "claude", "anthropic", "gemini", "copilot", "copilot studio", "azure ai", "azure openai", "perplexity", "mistral", "hugging face"]);
let DownloadTerms = dynamic(["download", "filedownloaded", "download file", "export", "get file"]);
CloudAppEvents
| where Timestamp > ago(Lookback)
| extend App = tolower(Application),
         User = coalesce(AccountId, AccountDisplayName),
         Action = tolower(ActionType),
         Activity = tolower(ActivityType)
| where App has_any (AIApps)
| where Action has_any (DownloadTerms) or Activity has_any (DownloadTerms)
| summarize DownloadCount = count(),
            ObjectNames = make_set(ObjectName, 25),
            ObjectTypes = make_set(ObjectType, 10),
            IPs = make_set(IPAddress, 20)
    by User, Application, DeviceType, OSPlatform
| sort by DownloadCount desc
