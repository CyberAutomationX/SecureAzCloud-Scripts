// Name: Rare AI Domain Access
// Purpose: Detect first-seen or rare AI destinations accessed by a device-process pair in the last day.
// Data Source(s): DeviceNetworkEvents
// Tuning: Increase the historical window or add sanctioned domains if your environment regularly tests new AI services.


let RecentWindow = 1d;
let HistoricalWindow = 30d;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
let Historical =
DeviceNetworkEvents
| where Timestamp between (ago(HistoricalWindow) .. ago(RecentWindow))
| extend RemoteUrl_l = tolower(RemoteUrl)
| where isnotempty(RemoteUrl_l) and RemoteUrl_l has_any (AIDomains)
| summarize by DeviceName, InitiatingProcessFileName, RemoteUrl_l;
DeviceNetworkEvents
| where Timestamp > ago(RecentWindow)
| extend RemoteUrl_l = tolower(RemoteUrl),
         Actor = iff(isempty(InitiatingProcessAccountUpn), strcat(InitiatingProcessAccountDomain, "\\", InitiatingProcessAccountName), InitiatingProcessAccountUpn)
| where isnotempty(RemoteUrl_l) and RemoteUrl_l has_any (AIDomains)
| join kind=leftanti Historical on DeviceName, InitiatingProcessFileName, RemoteUrl_l
| summarize ConnectionCount = count(),
            FirstSeen = min(Timestamp),
            LastSeen = max(Timestamp)
    by DeviceName, DeviceId, Actor, InitiatingProcessFileName, RemoteUrl = RemoteUrl_l, InitiatingProcessSHA1
| sort by LastSeen desc
