// Name: Sensitive File Access Followed by AI Domain Connection
// Purpose: Detect bursts of sensitive file interaction followed by short-term AI access from the same user and device.
// Data Source(s): DeviceFileEvents, DeviceNetworkEvents
// Tuning: Tune the file extension list and minimum SensitiveFileCount for your document-heavy teams.


let Lookback = 7d;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
let SensitiveExtensions = dynamic([".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".pdf", ".csv", ".txt", ".rtf", ".sql", ".ps1", ".psm1", ".tf", ".tfvars", ".json", ".yaml", ".yml", ".env", ".pem", ".key", ".pfx", ".kdbx", ".bak", ".zip", ".7z", ".rar"]);
let SensitiveFileActivity =
DeviceFileEvents
| where Timestamp > ago(Lookback)
| extend Ext = tostring(extract(@"(\.[^\.\\/]+)$", 1, FileName)),
         Actor = iff(isempty(InitiatingProcessAccountUpn), strcat(InitiatingProcessAccountDomain, "\\", InitiatingProcessAccountName), InitiatingProcessAccountUpn)
| where set_has_element(SensitiveExtensions, tolower(Ext))
| project FileTime = Timestamp, DeviceId, DeviceName, Actor, FileName, FolderPath, InitiatingProcessFileName, InitiatingProcessCommandLine;
let AITraffic =
DeviceNetworkEvents
| where Timestamp > ago(Lookback)
| extend RemoteUrl_l = tolower(RemoteUrl),
         Actor = iff(isempty(InitiatingProcessAccountUpn), strcat(InitiatingProcessAccountDomain, "\\", InitiatingProcessAccountName), InitiatingProcessAccountUpn)
| where isnotempty(RemoteUrl_l) and RemoteUrl_l has_any (AIDomains)
| project NetworkTime = Timestamp, DeviceId, DeviceName, Actor, RemoteUrl, InitiatingProcessFileName, InitiatingProcessCommandLine;
SensitiveFileActivity
| join kind=innerunique AITraffic on DeviceId, DeviceName, Actor
| where NetworkTime between (FileTime .. FileTime + 15m)
| summarize SensitiveFileCount = dcount(FileName),
            Files = make_set(strcat(FolderPath, "\\", FileName), 20),
            RemoteUrls = make_set(RemoteUrl, 20)
    by DeviceName, Actor, InitiatingProcessFileName, FileTime
| where SensitiveFileCount >= 3
| sort by FileTime desc
