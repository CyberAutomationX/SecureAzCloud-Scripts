// Name: Proxy Unmanaged User Agent to AI Domain
// Purpose: Find AI domain access where the client application or user agent does not look like a managed browser or standard enterprise client.
// Data Source(s): CommonSecurityLog
// Tuning: Refine KnownEnterpriseAgents with your managed browser string conventions.


let Lookback = 7d;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
let KnownEnterpriseAgents = dynamic(["edge", "chrome", "firefox", "safari", "microsoft office", "teams", "outlook", "defender", "windows"]);
CommonSecurityLog
| where TimeGenerated > ago(Lookback)
| extend Host = coalesce(tolower(tostring(parse_url(RequestURL).Host)), tolower(DestinationHostName), tolower(RequestURL)),
         User = coalesce(SourceUserName, SourceUserID),
         UserAgent = tolower(RequestClientApplication),
         Action = coalesce(SimplifiedDeviceAction, DeviceAction)
| where isnotempty(Host) and Host has_any (AIDomains)
| where isempty(UserAgent) or not(UserAgent has_any (KnownEnterpriseAgents))
| summarize EventCount = count(),
            SampleUrls = make_set(RequestURL, 15),
            UserAgents = make_set(RequestClientApplication, 15),
            Actions = make_set(Action, 10)
    by User, SourceIP, SourceHostName
| where EventCount >= 3
| sort by EventCount desc
