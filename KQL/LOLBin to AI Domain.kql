// Name: LOLBin to AI Domain
// Purpose: Detect living-off-the-land binaries reaching public AI domains, which is suspicious and often indicates command-line abuse.
// Data Source(s): DeviceNetworkEvents
// Tuning: Review remote management tooling and legacy automation that may legitimately use these binaries.


let Lookback = 7d;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
let LOLBins = dynamic(["certutil.exe","bitsadmin.exe","mshta.exe","regsvr32.exe","rundll32.exe","wmic.exe","forfiles.exe","installutil.exe","cmstp.exe"]);
DeviceNetworkEvents
| where Timestamp > ago(Lookback)
| extend RemoteUrl_l = tolower(RemoteUrl), Proc = tolower(InitiatingProcessFileName),
         Actor = iff(isempty(InitiatingProcessAccountUpn), strcat(InitiatingProcessAccountDomain, "\\", InitiatingProcessAccountName), InitiatingProcessAccountUpn)
| where isnotempty(RemoteUrl_l) and RemoteUrl_l has_any (AIDomains)
| where set_has_element(LOLBins, Proc)
| summarize ConnectionCount = count(), RemoteUrls = make_set(RemoteUrl, 20), SampleCommands = make_set(InitiatingProcessCommandLine, 10)
    by DeviceName, DeviceId, Actor, InitiatingProcessFileName, InitiatingProcessSHA1
| sort by ConnectionCount desc
