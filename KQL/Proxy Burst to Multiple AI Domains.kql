// Name: Proxy Burst to Multiple AI Domains
// Purpose: Identify users or hosts contacting several different AI domains in a short period, which may indicate tooling, testing, or evasion.
// Data Source(s): CommonSecurityLog
// Tuning: Helpful for identifying browser automation, API client rotation, or users trying multiple AI providers.


let Lookback = 3d;
let BurstWindow = 30m;
let AIDomains = dynamic(["openai.com", "chatgpt.com", "api.openai.com", "anthropic.com", "api.anthropic.com", "claude.ai", "gemini.google.com", "generativelanguage.googleapis.com", "makersuite.google.com", "cohere.ai", "api.cohere.ai", "mistral.ai", "api.mistral.ai", "perplexity.ai", "api.perplexity.ai", "huggingface.co", "api-inference.huggingface.co", "replicate.com", "api.replicate.com", "together.ai", "together.xyz", "fireworks.ai", "stability.ai", "grok.com", "x.ai"]);
CommonSecurityLog
| where TimeGenerated > ago(Lookback)
| extend Host = coalesce(tolower(tostring(parse_url(RequestURL).Host)), tolower(DestinationHostName), tolower(RequestURL)),
         User = coalesce(SourceUserName, SourceUserID)
| where isnotempty(Host) and Host has_any (AIDomains)
| summarize AIRequestCount = count(),
            DistinctDomains = dcount(Host),
            Domains = make_set(Host, 25),
            SampleUrls = make_set(RequestURL, 20)
    by User, SourceIP, SourceHostName, bin(TimeGenerated, BurstWindow)
| where DistinctDomains >= 3 and AIRequestCount >= 10
| sort by DistinctDomains desc, AIRequestCount desc
