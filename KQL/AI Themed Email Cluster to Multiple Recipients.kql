// Name: AI Themed Email Cluster to Multiple Recipients
// Purpose: Identify AI-themed campaigns sent to many recipients with similar content.
// Data Source(s): EmailEvents
// Tuning: Useful for phishing campaign detection and user-targeting scope analysis.


let Lookback = 14d;
let AIBrands = dynamic(["openai", "chatgpt", "gpt", "claude", "anthropic", "gemini", "copilot", "microsoft 365 copilot", "azure ai", "azure openai", "perplexity", "mistral", "hugging face"]);
EmailEvents
| where Timestamp > ago(Lookback)
| extend Subject_l = tolower(Subject),
         Display_l = tolower(SenderDisplayName),
         Domain_l = tolower(SenderFromDomain),
         Delivery_l = tolower(DeliveryAction)
| where Subject_l has_any (AIBrands) or Display_l has_any (AIBrands) or Domain_l has_any (AIBrands)
| where not(Delivery_l has_any (dynamic(["blocked", "dropped", "rejected"])))
| summarize RecipientCount = dcount(RecipientEmailAddress),
            Recipients = make_set(RecipientEmailAddress, 100),
            MessageCount = count(),
            DeliveryActions = make_set(DeliveryAction, 10)
    by SenderFromAddress, SenderFromDomain, SenderDisplayName, Subject
| where RecipientCount >= 5
| sort by RecipientCount desc, MessageCount desc
